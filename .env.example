# gemini-to-dsh — runtime configuration template.
#
# Copy to .env (or export the variables) and edit. Only ports and the master egress
# switch are active below, because their defaults are harmless. Everything that can
# carry a secret or a machine-specific path stays commented out: the default shown in
# the comment is what the code uses when the variable is absent.

# --- Where the bridge listens -----------------------------------------------------
# Loopback port for the OpenAI-compatible API. Default: 8787
AG_BRIDGE_PORT=8787

# Address the API binds to. Default: 127.0.0.1 (loopback; do not expose it).
# AG_BRIDGE_HOST=

# Bearer token clients must send. Default: local-bridge (fine on loopback only).
# Set a real value if anything other than this machine can reach the port.
# AG_BRIDGE_SECRET=

# Where request signatures are recorded. Default: ~/.dsh/ag-call-signatures.json
# AG_SIGNATURE_FILE=

# Set to 0 to keep the OS resolver as-is. Default: 1 (the bridge installs a
# fallback resolver when the local DNS answers with a poisoned address).
# AG_DNS_FALLBACK=

# --- Scoped egress -----------------------------------------------------------------
# Master switch for the local CONNECT shim that routes Google traffic. Default: 1
# Set to 0 to bypass the shim entirely (same as "enabled": false in the egress config).
AG_EGRESS=1

# Port the shim listens on. Default: 8789
AG_EGRESS_PORT=8789

# Path to the egress JSON config. Default: ~/.dsh/ag-egress.json
# AG_EGRESS_FILE=

# How long a resolved smart-DNS address is reused, in ms. Default: 60000
# AG_EGRESS_DNS_TTL=

# Per-connection budget for the whole route chain, in ms. Default: 6000
# AG_EGRESS_BUDGET=

# Shortcut for people who already run their own HTTP proxy: forces the shim on and
# fills the `proxy` slot. It does not reorder the chain — set "route": "proxy" in
# the egress config if you want that slot used.
# AG_GOOGLE_PROXY=

# --- Watchdog ----------------------------------------------------------------------
# How often a background probe checks that the active channel still works, in ms.
# Default: 120000 (2 minutes)
# AG_WATCHDOG_MS=

# Host used for that probe. Default: daily-cloudcode-pa.googleapis.com
# AG_WATCHDOG_HOST=

# --- OAuth client ------------------------------------------------------------------
# Required: there is no built-in client, and a token refresh cannot happen without
# one. Set both variables, or write them to a JSON file and point AG_OAUTH_FILE at it.
# The file form is {"client_id": "...", "client_secret": "..."}.
# AG_CLIENT_ID=
# AG_CLIENT_SECRET=

# Where that JSON file is read from when the variables above are unset.
# Default: ~/.dsh/ag-oauth.json
# AG_OAUTH_FILE=

# --- Tokens and accounts -----------------------------------------------------------
# OAuth credentials of the first account. Default: ~/.gemini/oauth_creds.json
# AG_CREDS_FILE=

# Rotation set (accounts beyond the first).
# Default: <dir of AG_CREDS_FILE>/dsh-bridge/accounts.json
# AG_ACCOUNTS_FILE=

# --- Model behaviour ---------------------------------------------------------------
# Aliases as from=to,from2=to2. Default: gemini-3.8-flash=gemini-3.8-flash-tiered
# AG_MODEL_ALIASES=

# --- Pacing ------------------------------------------------------------------------
# Stream pacing on/off. Default: 1; set 0 to emit chunks as fast as they arrive.
# AG_PACE=
# Milliseconds between paced chunks. Default: 30
# AG_PACE_MS=

# --- Images ------------------------------------------------------------------------
# Model that draws. Default: gemini-3.1-flash-image
# Anything with "-image" in the name is treated as an image model automatically.
# AG_IMAGE_MODEL=

# Where generated pictures are written. Default: ~/.dsh/images
# The answer carries an absolute path as markdown, so a chat client can show it.
# AG_IMAGE_DIR=

# Route plain words like "нарисуй кота" (or "draw a cat") to the image model, whichever
# text model the client actually asked for. Default: 1; set 0 to require the model by name.
# AG_IMAGE_AUTO=

# --- Web search --------------------------------------------------------------------
# Path to the search provider config. Default: ~/.dsh/search.json
# DSH_SEARCH_CONFIG=
# how long the upstream may stay silent before an attempt counts as failed
AG_UPSTREAM_TIMEOUT_MS=150000

# how many times an answer the transport cut in half is continued instead of failed
AG_RESUME_ATTEMPTS=2

# hub identity version; below it Google withholds some quota groups
AG_HUB_VERSION=2.26.0

# how often to check whether a system VPN adapter is up
AG_VPN_REFRESH_MS=15000
